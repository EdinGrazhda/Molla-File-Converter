<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Molla</AssemblyName>
    <RootNamespace>Molla.Linux</RootNamespace>
    <ApplicationManifest></ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <AvaloniaResource Include="Assets/molla-icon.png" />
    <Content Include="Assets/Fonts/LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="fonts.conf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <ProjectReference Include="../Molla.Core/Molla.Core.csproj" />
  </ItemGroup>
</Project>
